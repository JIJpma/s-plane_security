# Network interface on the Pi connected to the FH switch
IFACE=eth0

# Attacker MAC to advertise in spoofed Announce packets
# Leave blank to auto-detect from /sys/class/net/<IFACE>/address on the Pi
SPOOF_SRC_MAC=02:11:22:33:44:55

# BMCA priority fields — 0 is the lowest value and therefore wins over any legitimate clock
SPOOF_PRIORITY1=0
SPOOF_PRIORITY2=0
SPOOF_CLOCK_CLASS=0

# How long (seconds) to flood spoofed Announce packets after the first real one is seen
SPOOF_DURATION=60

# Seconds between each spoofed Announce (0.125 = 8 Hz, the standard PTP Announce rate)
SPOOF_INTERVAL=0.125

# How long (seconds) to run the live replay attack
REPLAY_DURATION=30

# Path to a captured PCAP file used by the demo/offline modes
# PCAP_PATH=./captures/ptp_server.pcap
PCAP_PATH=../Testbed/PipelineTestAttacker/test_ptp_packets/ptp_server.pcap
